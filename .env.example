# ── Supabase (pre-provisioned, do not change) ───────────────────────────────
VITE_SUPABASE_URL=your-supabase-url-here
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_URL=your-supabase-url-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_DB_URL=your-supabase-db-url-here

# ── AI / LLM Provider (optional — agent falls back to deterministic if unset) ──
# OpenAI-compatible API. Leave empty to use the deterministic fallback agent.
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Razorpay Test Mode (optional — simulator is default) ─────────────────────
# Leave empty to use the local payment simulator.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Policy Engine Configuration ─────────────────────────────────────────────
POLICY_MAX_RETRY_COUNT=3
POLICY_MIN_RETRY_INTERVAL_SECONDS=3600
POLICY_COOLDOWN_SECONDS=1800
POLICY_HIGH_VALUE_THRESHOLD=500000
POLICY_ESCALATION_CONFIDENCE_THRESHOLD=0.5
POLICY_MAX_COMMUNICATION_ATTEMPTS=3

# ── Dataset Generation ───────────────────────────────────────────────────────
DATASET_SEED=42
DATASET_SIZE=50000

# ── Simulator ────────────────────────────────────────────────────────────────
SIMULATOR_SEED=42
SIMULATOR_SUCCESS_RATE=0.72
SIMULATOR_TIMEOUT_RATE=0.05
SIMULATOR_NETWORK_ERROR_RATE=0.03
SIMULATOR_RATE_LIMIT_RATE=0.02
SIMULATOR_MAX_LATENCY_MS=3000
